{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "isolatedModules": true
  },
  "include": ["src"],
  // `sample/` is the workspace the playground loads, not part of the playground.
  // It is source text in fifteen languages that is meant to be parsed, not compiled.
  "exclude": ["sample"]
}
