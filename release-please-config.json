{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "fun-refactor",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "include-v-in-tag": true,
      "extra-files": [
        "sdk/python/src/fr_ir/_version.py"
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "build",
          "section": "Build"
        },
        {
          "type": "ci",
          "section": "Continuous integration",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Housekeeping",
          "hidden": true
        }
      ]
    }
  },
  "separate-pull-requests": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "The next release, as the commits since the last one describe it."
}
