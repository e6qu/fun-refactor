+/// Returns the UTF-8 byte length of the escaped form of `pattern`.
+pub fn escape_len(pattern: &str) -> usize {
+    pattern
+        .chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
+}
