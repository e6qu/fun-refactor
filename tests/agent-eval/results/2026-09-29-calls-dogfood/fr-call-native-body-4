        loop {
            self.solver.rounds += 1;
            let names: Vec<_> = self.solver.table.keys().cloned().collect();
            let mut changed = false;
            for name in &names {
                if self.remaining == 0 {
                    self.cutoff("step-budget");
                    break;
                }
                let function = self.functions[name];
                (self.file, self.source) = self.contexts[name];
                let parameters: Vec<_> = self.parameter_nodes(function).unwrap_or_default().into_iter()
