+/// Calculates a normalized score of the optimal string alignment algorithm between
+/// 0.0 and 1.0 (inclusive), where 1.0 means the strings are the same.
+/// Each substring can only be edited once. Lengths count Unicode scalar values.
+///
+/// ```
+/// use strsim::normalized_osa_distance;
+///
+/// assert_eq!(0.5, normalized_osa_distance("ab", "ba"));
+/// assert_eq!(0.0, normalized_osa_distance("ab", "bca"));
+/// assert_eq!(0.5, normalized_osa_distance("é香", "香é"));
+/// assert_eq!(1.0, normalized_osa_distance("", ""));
+/// assert_eq!(0.0, normalized_osa_distance("", "香"));
+/// assert_eq!(0.0, normalized_osa_distance("香", ""));
+/// assert_eq!(1.0, normalized_osa_distance("string", "string"));
+/// ```
+pub fn normalized_osa_distance(a: &str, b: &str) -> f64 {
+    if a.is_empty() && b.is_empty() {
+        return 1.0;
+    }
+    1.0 - (osa_distance(a, b) as f64) / (a.chars().count().max(b.chars().count()) as f64)
+}
