 pub mod utf8;
 
+/// Returns the UTF-8 byte length of the escaped form of `text`.
+///
+/// This is equivalent to calling [`escape`] and then [`str::len`] on the
+/// returned string, but does not allocate.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + if is_meta_character(c) { 1 } else { 0 })
+        .sum()
+}
