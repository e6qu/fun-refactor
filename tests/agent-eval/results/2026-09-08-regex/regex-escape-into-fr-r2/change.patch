+/// Appends the regex-escaped form of `pattern` to `buf`, preserving its existing
+/// contents.
+///
+/// This escapes all regular expression metacharacters in `pattern`, just like
+/// [`escape`], without allocating an intermediate string. The buffer may grow
+/// if its capacity is insufficient.
+pub fn escape_into(pattern: &str, buf: &mut alloc::string::String) {
+    regex_syntax::escape_into(pattern, buf);
+}
