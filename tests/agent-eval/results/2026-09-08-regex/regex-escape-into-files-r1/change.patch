+/// Escapes all regular expression meta characters in `pattern` and appends the
+/// result to `buf`, preserving its existing contents.
+///
+/// The appended text is identical to [`escape(pattern)`](escape) and may be
+/// safely used as a literal in a regular expression. This writes directly into
+/// `buf` without allocating an intermediate escaped string.
+pub fn escape_into(pattern: &str, buf: &mut alloc::string::String) {
+    regex_syntax::escape_into(pattern, buf);
+}
