 // Independent source revision while the investigation was interrupted.
+/// Returns the length, in bytes, of the escaped form of the given regular expression text.
+///
+/// This function does not allocate.
+pub fn escape_len(text: &str) -> usize {
+    text.len() + text.chars().filter(|&c| is_meta_character(c)).count()
+}
