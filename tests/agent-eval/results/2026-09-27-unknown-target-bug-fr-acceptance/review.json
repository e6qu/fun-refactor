\\n    if a == b {\\n        return 1.0;\\n    }\\n\\n    let a_len = a.chars().count();\\n    let b_len = b.chars().count();\\n\\n    if a_len < 2 || b_len < 2 {\\n        return 0.0;\\n    }\\n\\n    let mut a_bigrams: HashMap<(char, char), usize> = HashMap::new();\\n\\n    for bigram in bigrams(&a) {\\n        *a_bigrams.entry(bigram).or_insert(0) += 1;\\n    }\\n\\n    let mut intersection_size = 0_usize;\\n\\n    for bigram in bigrams(&b) {\\n        a_bigrams.entry(bigram).and_modify(|bi| {\\n            if *bi > 0 {\\n                *bi -= 1;\\n                intersection_size += 1;\\n            }\\n        });\\n    }\\n\\n    (2 * intersection_size) as f64 / (a_len + b_len - 2) as f64\\n}\"}],\"postconditions\":{\"files-changed\":1,\"edits\":1,\"paths-changed\":[\"src/lib.rs\"]},\"checks\":[\"upstream\"],\"delivery\":{\"check-original\":true,\"compact-success\":true,\"exercise-reversal\":true,\"patch\":\"artifacts/change.patch\",\"check-output-bytes\":1024}}","paths":["src/lib.rs"],"report":{"author":{"atomic_snapshot":false,"behavior_checked":false,"changed":true,"context_inherited":["coverage","revision","handle_prefix"],"diff":"--- a/src/lib.rs\n+++ b/src/lib.rs\n@@ -729,7 +729,10 @@\n         return 1.0;\n     }\n \n-    if a.len() < 2 || b.len() < 2 {\n+    let a_len = a.chars().count();\n+    let b_len = b.chars().count();\n+\n+    if a_len < 2 || b_len < 2 {\n         return 0.0;\n     }\n \n@@ -750,7 +753,7 @@\n         });\n     }\n \n-    (2 * intersection_size) as f64 / (a.len() + b.len() - 2) as f64\n+    (2 * intersection_size) as f64 / (a_len + b_len - 2) as f64\n }\n \n #[cfg(test)]\n","files_changed":1,"postconditions":[{"actual":1,"expected":1,"held":true,"postcondition":"files-changed"},{"actual":1,"expected":1,"held":true,"postcondition":"edits"},{"actual":["src/lib.rs"],"expected":["src/lib.rs"],"held":true,"postcondition":"paths-changed"}],"postconditions_held":true,"query":"batch","schema":"fr-author-batch-1","span_basis":"original-