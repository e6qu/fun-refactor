+/// Calculates a normalized score of the optimal string alignment algorithm
+/// between 0.0 and 1.0 (inclusive), where 1.0 means the strings are the same.
+/// Each substring can only be edited once.
+///
+/// ```
+/// use strsim::normalized_osa_distance;
+///
+/// assert!((normalized_osa_distance("ab", "ba") - 0.5).abs() < 0.00001);
+/// assert!(normalized_osa_distance("ab", "bca").abs() < 0.00001);
+/// assert!((normalized_osa_distance("é猫", "猫é") - 0.5).abs() < 0.00001);
+/// assert!((normalized_osa_distance("", "") - 1.0).abs() < 0.00001);
+/// assert!(normalized_osa_distance("", "second").abs() < 0.00001);
+/// assert!(normalized_osa_distance("first", "").abs() < 0.00001);
+/// assert!((normalized_osa_distance("string", "string") - 1.0).abs() < 0.00001);
+/// ```
+pub fn normalized_osa_distance(a: &str, b: &str) -> f64 {
+    if a.is_empty() && b.is_empty() {
+        return 1.0;
+    }
+    1.0 - (osa_distance(a, b) as f64) / (a.chars().count().max(b.chars().count()) as f64)
+}
