@@ -1304,4 +1307,19 @@ mod tests {
             sorensen_dice("this has one extra word", "this has one word")
         );
     }
+
+    #[test]
+    fn sorensen_dice_unicode() {
+        // lengths are counted in Unicode scalar values, not bytes
+        assert_delta!(2.0 / 3.0, sorensen_dice("éa", "éab"));
+        // whitespace is removed before counting
+        assert_delta!(2.0 / 3.0, sorensen_dice("é a", "éa b"));
+        // duplicate bigrams retain their multiplicity
+        assert_delta!(2.0 / 3.0, sorensen_dice("aa", "aaa"));
+        // unequal inputs with fewer than two scalar values score zero
+        assert_delta!(0.0, sorensen_dice("é", "ab"));
+        assert_delta!(0.0, sorensen_dice("é", "éx"));
+        // equal inputs still score one
+        assert_delta!(1.0, sorensen_dice("é", "é"));
+    }
