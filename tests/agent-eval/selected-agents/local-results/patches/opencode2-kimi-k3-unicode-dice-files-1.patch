+
+    #[test]
+    fn sorensen_dice_unicode() {
+        // Bigrams are counted over Unicode scalar values, so multibyte
+        // characters must not inflate the denominator.
+        assert_delta!(2.0 / 3.0, sorensen_dice("éa", "éab"));
+        assert_delta!(2.0 / 3.0, sorensen_dice("éab", "éa"));
+        // Whitespace is still removed before counting.
+        assert_delta!(2.0 / 3.0, sorensen_dice("é a", "éa b"));
+        // Equal inputs still score 1.0, even when shorter than two values.
+        assert_delta!(1.0, sorensen_dice("é", "é"));
+        assert_delta!(1.0, sorensen_dice("é é", "éé"));
+        // Unequal inputs shorter than two scalar values score 0.0.
+        assert_delta!(0.0, sorensen_dice("é", "a"));
+        assert_delta!(0.0, sorensen_dice("é", "ab"));
+        assert_delta!(0.0, sorensen_dice("ab", "é"));
+        // Duplicate bigram multiplicity is retained for Unicode input:
+        // the single (é, é) pair in the first string matches only one of
+        // the two pairs in the second string.
+        assert_delta!(2.0 / 3.0, sorensen_dice("éé", "ééé"));
+        assert_delta!(0.0, sorensen_dice("éa", "aé"));
+    }
 }
