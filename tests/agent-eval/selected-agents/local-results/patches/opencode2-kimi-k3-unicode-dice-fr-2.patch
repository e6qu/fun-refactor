+
+    #[test]
+    fn sorensen_dice_unicode() {
+        // bigrams are counted over Unicode scalar values, not bytes
+        assert_delta!(2.0 / 3.0, sorensen_dice("éa", "éab"));
+        assert_delta!(2.0 / 3.0, sorensen_dice("é a", "éa b"));
+        assert_delta!(1.0, sorensen_dice("éa", "éa"));
+        assert_delta!(1.0, sorensen_dice("é a", "éa"));
+        assert_delta!(0.0, sorensen_dice("é", "éa"));
+        assert_delta!(0.0, sorensen_dice("éa", "é"));
+        assert_delta!(0.0, sorensen_dice("é", "ä"));
+        // duplicate bigrams keep their multiplicity
+        assert_delta!(1.0, sorensen_dice("éaéa", "éaéa"));
+        assert_delta!(0.5, sorensen_dice("éaéa", "éa"));
+    }
