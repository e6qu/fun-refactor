{"type":"tool_use","timestamp":1790931575764,"sessionID":"ses_f04290508ffeeCt1RYGZWwMNUW","part":{"type":"tool","tool":"rehearsal_search_source","callID":"tool_1mLFr46TexzDi337goxBaSXB","state":{"status":"completed","input":{"text":"class Namespace"},"output":"{\"matches\":[{\"line\":483,\"offset\":18087,\"path\":\"src/blinker/base.py\",\"sha256\":\"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3\",\"text\":\"class Namespace(dict[str, NamedSignal]):\"}],\"omitted_matches\":0,\"unreadable_files\":1}","metadata":{"truncated":false},"title":"","time":{"start":1790931575760,"end":1790931575763}},"id":"prt_0fbd7223d001cjMDz8RcM15n1m","sessionID":"ses_f04290508ffeeCt1RYGZWwMNUW","messageID":"msg_0fbd719f4001QA10L1pPPwmDWN"}}
