{"type":"text","timestamp":1790931585005,"sessionID":"ses_f04290508ffeeCt1RYGZWwMNUW","part":{"id":"prt_0fbd74498001ts0npK4NbQBQsv","messageID":"msg_0fbd7307700118WdRU16647rCg","sessionID":"ses_f04290508ffeeCt1RYGZWwMNUW","type":"text","text":"The module-level `signal` is a bound method of `default_namespace`, so validating in `Namespace.signal` covers both entry points.","time":{"start":1790931584152,"end":1790931585002}}}
{"type":"tool_use","timestamp":1790931585016,"sessionID":"ses_f04290508ffeeCt1RYGZWwMNUW","part":{"type":"tool","tool":"rehearsal_replace_source","callID":"tool_CJvJ5JxGIpnR5vsQk8Xp84Dv","state":{"status":"completed","input":{"path":"src/blinker/base.py","sha256":"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3","old":"        :param name: The name of the signal.\n        :param doc: The docstring of the signal.\n        \"\"\"\n        if name not in self:\n            self[name] = NamedSignal(name, doc)\n\n        return self[name]","new":"        :param name: The name of the signal.\n        :param doc: The docstring of the signal.\n        \"\"\"\n        if not isinstance(name, str):\n            raise TypeError(f\"name must be a str, not {type(name).__name__}\")\n\n        if name not in self:\n            self[name] = NamedSignal(name, doc)\n\n        return self[name]"},"output":"{\"before_sha256\":\"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3\",\"bytes\":19249,\"path\":\"src/blinker/base.py\",\"sha256\":\"459edaf7a0460112ec43119f9a2881fa71105a9b8b05da98a40f102a26f42b3c\"}","metadata":{"truncated":false},"title":"","time":{"start":1790931585001,"end":1790931585010}},"id":"prt_0fbd745970014gEBFGqMg5HFx6","sessionID":"ses_f04290508ffeeCt1RYGZWwMNUW","messageID":"msg_0fbd7307700118WdRU16647rCg"}}
