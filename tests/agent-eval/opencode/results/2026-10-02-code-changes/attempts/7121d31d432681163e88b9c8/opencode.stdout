{"type":"tool_use","timestamp":1790931796504,"sessionID":"ses_f04269f0effecb5uQj2TE3xP33","part":{"type":"tool","tool":"rehearsal_replace_source","callID":"call_951c225bc54c4d0f879dce21","state":{"status":"completed","input":{"new":"Version 1.10.0\n--------------\n\nUnreleased\n\n-   ``Namespace.signal`` and the ``signal`` function raise ``TypeError`` if\n    ``name`` is not a ``str``.\n\n\nVersion 1.9.0\n-------------","old":"Version 1.10.0\n--------------\n\nUnreleased\n\n\nVersion 1.9.0\n-------------","path":"CHANGES.rst","sha256":"5c74d514845126dc0da56ee143f468851f9278e5a207e5df95b1ad2c8a70ad62"},"output":"{\"before_sha256\":\"5c74d514845126dc0da56ee143f468851f9278e5a207e5df95b1ad2c8a70ad62\",\"bytes\":5423,\"path\":\"CHANGES.rst\",\"sha256\":\"f7cb74384488000f2c6449d7ff4cbc9661ee98030db39b65e9ab11e463f0f2c6\"}","metadata":{"truncated":false},"title":"","time":{"start":1790931796495,"end":1790931796498}},"id":"prt_0fbda820d001M4hKZEc78RI0CH","sessionID":"ses_f04269f0effecb5uQj2TE3xP33","messageID":"msg_0fbda4c41001nJVOVbspUxkQ4W"}}
