{"type":"tool_use","timestamp":1790931753420,"sessionID":"ses_f04269f0effecb5uQj2TE3xP33","part":{"type":"tool","tool":"rehearsal_read_source","callID":"call_fc8d50164ba94a2c84cf1bf6","state":{"status":"completed","input":{"bytes":4096,"offset":0,"path":"src/blinker/__init__.py","sha256":""},"output":"{\"end_offset\":317,\"next_offset\":null,\"offset\":0,\"path\":\"src/blinker/__init__.py\",\"sha256\":\"23611d66aa72e0bca35f5ec79f5cb32465828de2da55a3f3b0c80790b7e3fdc4\",\"size_bytes\":317,\"text\":\"from __future__ import annotations\\n\\nfrom .base import ANY\\nfrom .base import default_namespace\\nfrom .base import NamedSignal\\nfrom .base import Namespace\\nfrom .base import Signal\\nfrom .base import signal\\n\\n__all__ = [\\n    \\\"ANY\\\",\\n    \\\"default_namespace\\\",\\n    \\\"NamedSignal\\\",\\n    \\\"Namespace\\\",\\n    \\\"Signal\\\",\\n    \\\"signal\\\",\\n]\\n\"}","metadata":{"truncated":false},"title":"","time":{"start":1790931753412,"end":1790931753419}},"id":"prt_0fbd9d9c1001tNUKzlN5KA1wFA","sessionID":"ses_f04269f0effecb5uQj2TE3xP33","messageID":"msg_0fbd9a126001l5LzbrnoMxrtCT"}}
