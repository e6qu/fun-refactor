{"type":"tool_use","timestamp":1790931782723,"sessionID":"ses_f04269f0effecb5uQj2TE3xP33","part":{"type":"tool","tool":"rehearsal_replace_source","callID":"call_71d9c334341348a6a5effbb7","state":{"status":"completed","input":{"new":"    def signal(self, name: str, doc: str | None = None) -> NamedSignal:\n        \"\"\"Return the :class:`NamedSignal` for the given ``name``, creating it\n        if required. Repeated calls with the same name return the same signal.\n\n        :param name: The name of the signal.\n        :param doc: The docstring of the signal.\n        \"\"\"\n        if not isinstance(name, str):\n            raise TypeError(\"name must be a string\")\n\n        if name not in self:\n            self[name] = NamedSignal(name, doc)\n\n        return self[name]","old":"    def signal(self, name: str, doc: str | None = None) -> NamedSignal:\n        \"\"\"Return the :class:`NamedSignal` for the given ``name``, creating it\n        if required. Repeated calls with the same name return the same signal.\n\n        :param name: The name of the signal.\n        :param doc: The docstring of the signal.\n        \"\"\"\n        if name not in self:\n            self[name] = NamedSignal(name, doc)\n\n        return self[name]","path":"src/blinker/base.py","sha256":"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3"},"output":"{\"before_sha256\":\"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3\",\"bytes\":19224,\"path\":\"src/blinker/base.py\",\"sha256\":\"bbc7d3b2f43d0e53738b9624aebc17790f7486971a1449c0c3243fda96270e95\"}","metadata":{"truncated":false},"title":"","time":{"start":1790931782715,"end":1790931782718}},"id":"prt_0fbda4c3a001SwaVjtpGIdgI16","sessionID":"ses_f04269f0effecb5uQj2TE3xP33","messageID":"msg_0fbda27f4001s7YJRIJ3INMueu"}}
