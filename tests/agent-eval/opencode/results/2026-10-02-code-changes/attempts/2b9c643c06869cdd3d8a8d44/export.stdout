        {
          "type": "tool",
          "tool": "rehearsal_read_source",
          "callID": "call_f48cfe6e52b74a3aa4914a01",
          "state": {
            "status": "completed",
            "input": {
              "bytes": 8192,
              "offset": 0,
              "path": "tests/test_signals.py",
