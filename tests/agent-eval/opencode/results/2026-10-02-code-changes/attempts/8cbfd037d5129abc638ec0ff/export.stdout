          "state": {
            "status": "completed",
            "input": {
              "summary": "Added string-name validation to Namespace.signal in src/blinker/base.py: an isinstance(name, str) check raises TypeError before any dictionary lookup/modification, so non-string names are rejected even if already present as keys; str subclasses and \"\" pass through. Since the module-level `signal` helper is the bound method `default_namespace.signal`, it gains the same validation automatically. Signal identity for repeated names, docstring handling, and all other behavior are unchanged. Added a `.. versionchanged:: 1.10` note to the docstring and a CHANGES.rst entry under 1.10.0. Uncertainty: exact TypeError message wording is my choice (mentions the offending type name); tests were not run locally."
            },
            "output": "{\"changed_paths\":[\"CHANGES.rst\",\"src/blinker/base.py\"],\"source_sha256\":\"798ef401fb0047ff21a732cc120242c7caf081796b97634c1c802d29c5eb875d\",\"submission_sha256\":\"85cb69d081537453d6de3051f5b3eab620c0de8417f960e6142a3baa2eae8d1b\",\"submitted\":true}",
