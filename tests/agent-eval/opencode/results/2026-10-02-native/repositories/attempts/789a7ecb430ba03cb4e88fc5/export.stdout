ne\":72,\"offset\":3119,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"        :attr:`default_fallback_signers`.\"},{\"line\":79,\"offset\":3303,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"        Removed the default SHA-512 fallback signer from\"},{\"line\":80,\"offset\":3360,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"        ``default_fallback_signers``.\"},{\"line\":83,\"offset\":3427,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"        Added support for ``fallback_signers`` and configured a default\"},{\"line\":84,\"offset\":3499,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"        SHA-512 fallback. This fallback is for users who used the yanked\"},{\"line\":101,\"offset\":4195,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"    #: The default fallback signers to try when unsigning fails.\"},{\"line\":102,\"offset\":4260,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"    default_fallback_signers: list[\"},{\"line\":116,\"offset\":4876,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"        fallback_signers: list[\"},{\"line\":132,\"offset\":5492,\"path\":\"src/itsdangerous/serializer.py\",\"sha256\":\"6d6f1687897c7e3ac6eeff5bfd6794df90e299feedcc6aae3faa0e53ffe925e8\",\"text\":\"        fallback_signers: list[\"},{\"line\":149,\"offset\":6134,\"path\":\"src/itsdan