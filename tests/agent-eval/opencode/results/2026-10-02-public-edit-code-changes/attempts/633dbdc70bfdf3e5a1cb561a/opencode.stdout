{"type":"tool_use","timestamp":1790945584350,"sessionID":"ses_f0353b185ffeM2tvJM2JJdxsJo","part":{"type":"tool","tool":"rehearsal_replace_source","callID":"tool_vrwzv8pV1IVFTC3qfEPldauC","state":{"status":"completed","input":{"new":"    def signal(self, name: str, doc: str | None = None) -> NamedSignal:\n        \"\"\"Return the :class:`NamedSignal` for the given ``name``, creating it\n        if required. Repeated calls with the same name return the same signal.\n\n        :param name: The name of the signal.\n        :param doc: The docstring of the signal.\n        \"\"\"\n        if not isinstance(name, str):\n            raise TypeError(f\"Signal name must be a string, not {type(name).__name__!r}.\")\n\n        if name not in self:\n            self[name] = NamedSignal(name, doc)\n\n        return self[name]","old":"    def signal(self, name: str, doc: str | None = None) -> NamedSignal:\n        \"\"\"Return the :class:`NamedSignal` for the given ``name``, creating it\n        if required. Repeated calls with the same name return the same signal.\n\n        :param name: The name of the signal.\n        :param doc: The docstring of the signal.\n        \"\"\"\n        if name not in self:\n            self[name] = NamedSignal(name, doc)\n\n        return self[name]","path":"src/blinker/base.py","sha256":"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3"},"output":"{\"before_sha256\":\"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3\",\"bytes\":19262,\"path\":\"src/blinker/base.py\",\"sha256\":\"0f18058503918ddd1696d23f7fb1394a25263b322049392d7f7858fb49d601e9\"}","metadata":{"truncated":false},"title":"","time":{"start":1790945584338,"end":1790945584342}},"id":"prt_0fcacd20b001bYXAszFGJqA4k4","sessionID":"ses_f0353b185ffeM2tvJM2JJdxsJo","messageID":"msg_0fcac9fc0001DYNVzqQLNcqypS"}}
