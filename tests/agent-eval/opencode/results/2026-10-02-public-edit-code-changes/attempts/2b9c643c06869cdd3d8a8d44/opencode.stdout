{"type":"tool_use","timestamp":1790945759346,"sessionID":"ses_f0351a551ffeWwEKJCuNKZvmPD","part":{"type":"tool","tool":"rehearsal_read_source","callID":"call_b118a58bde7845bc86e7b575","state":{"status":"completed","input":{"bytes":2048,"offset":18087,"path":"src/blinker/base.py","sha256":"bbc7d3b2f43d0e53738b9624aebc17790f7486971a1449c0c3243fda96270e95"},"output":"{\"end_offset\":19224,\"next_offset\":null,\"offset\":18087,\"path\":\"src/blinker/base.py\",\"sha256\":\"bbc7d3b2f43d0e53738b9624aebc17790f7486971a1449c0c3243fda96270e95\",\"size_bytes\":19224,\"text\":\"class Namespace(dict[str, NamedSignal]):\\n    \\\"\\\"\\\"A dict mapping names to signals.\\\"\\\"\\\"\\n\\n    def signal(self, name: str, doc: str | None = None) -> NamedSignal:\\n        \\\"\\\"\\\"Return the :class:`NamedSignal` for the given ``name``, creating it\\n        if required. Repeated calls with the same name return the same signal.\\n\\n        :param name: The name of the signal.\\n        :param doc: The docstring of the signal.\\n        \\\"\\\"\\\"\\n        if not isinstance(name, str):\\n            raise TypeError(\\\"name must be a string\\\")\\n\\n        if name not in self:\\n            self[name] = NamedSignal(name, doc)\\n\\n        return self[name]\\n\\n\\nclass _PNamespaceSignal(t.Protocol):\\n    def __call__(self, name: str, doc: str | None = None) -> NamedSignal: ...\\n\\n\\ndefault_namespace: Namespace = Namespace()\\n\\\"\\\"\\\"A default :class:`Namespace` for creating named signals. :func:`signal`\\ncreates a :class:`NamedSignal` in this namespace.\\n\\\"\\\"\\\"\\n\\nsignal: _PNamespaceSignal = default_namespace.signal\\n\\\"\\\"\\\"Return a :class:`NamedSignal` in :data:`default_namespace` with the given\\n``name``, creating it if required. Repeated calls with the same name return the\\nsame signal.\\n\\\"\\\"\\\"\\n\"}","metadata":{"truncated":false},"title":"","time":{"start":1790945759319,"end":1790945759321}},"id":"prt_0fcaf9055001QXjKY2m0rXKLpg","sessionID":"ses_f0351a551ffeWwEKJCuNKZvmPD","messageID":"msg_0fcaf778a001fMTB3PweNP02MM"}}
