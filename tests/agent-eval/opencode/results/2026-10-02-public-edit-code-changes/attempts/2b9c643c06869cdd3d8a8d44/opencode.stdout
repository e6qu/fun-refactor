{"type":"tool_use","timestamp":1790945752972,"sessionID":"ses_f0351a551ffeWwEKJCuNKZvmPD","part":{"type":"tool","tool":"rehearsal_replace_source","callID":"call_9376f04e90cb4bbc870d899d","state":{"status":"completed","input":{"new":"        \"\"\"\n        if not isinstance(name, str):\n            raise TypeError(\"name must be a string\")\n\n        if name not in self:\n            self[name] = NamedSignal(name, doc)","old":"        \"\"\"\n        if name not in self:\n            self[name] = NamedSignal(name, doc)","path":"src/blinker/base.py","sha256":"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3"},"output":"{\"before_sha256\":\"4290eebd75dcc09178f65501707e418924f8e91cfdc121bb556fe9ecdff4dbb3\",\"bytes\":19224,\"path\":\"src/blinker/base.py\",\"sha256\":\"bbc7d3b2f43d0e53738b9624aebc17790f7486971a1449c0c3243fda96270e95\"}","metadata":{"truncated":false},"title":"","time":{"start":1790945752960,"end":1790945752966}},"id":"prt_0fcaf777d001vDAsXiZYyJvDnT","sessionID":"ses_f0351a551ffeWwEKJCuNKZvmPD","messageID":"msg_0fcaf3d2a001nGp3FJJlsNB3IV"}}
