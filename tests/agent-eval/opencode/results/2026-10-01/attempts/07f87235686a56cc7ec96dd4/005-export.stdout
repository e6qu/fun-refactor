      "parts": [
        {
          "type": "text",
          "text": "Action result:\n{\"end_offset\":324,\"next_offset\":null,\"offset\":0,\"path\":\"intervals.py\",\"sha256\":\"95d7e0377e63f77ddfd8916f81a19f98647e64471c48ca760a8732b01b8bd679\",\"size_bytes\":324,\"text\":\"\\\"\\\"\\\"Operations on half-open integer intervals.\\\"\\\"\\\"\\n\\n\\ndef overlaps(left, right):\\n    \\\"\\\"\\\"Return whether two intervals share an integer point.\\\"\\\"\\\"\\n    return max(left[0], right[0]) <= min(left[1], right[1])\\n\\n\\ndef span(interval):\\n    \\\"\\\"\\\"Return the nonnegative length of an interval.\\\"\\\"\\\"\\n    return max(0, interval[1] - interval[0])\\n\"}\nReturn the next JSON action.",
