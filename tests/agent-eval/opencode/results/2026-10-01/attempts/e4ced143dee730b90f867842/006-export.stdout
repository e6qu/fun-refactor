          "text": "Action result:\n{\"end_offset\":722,\"next_offset\":null,\"offset\":0,\"path\":\"sequences.py\",\"sha256\":\"012c9ff830336d009d278b80f1faf2f363bbcc332c018eb1ac51add7b24752f5\",\"size_bytes\":722,\"text\":\"\\\"\\\"\\\"Small sequence transformations.\\\"\\\"\\\"\\n\\n\\ndef stable_unique(values):\\n    \\\"\\\"\\\"Keep the first occurrence of each equality-distinct value.\\\"\\\"\\\"\\n    result = []\\n    seen_hashable = set()\\n    seen_unhashable = []\\n    for item in values:\\n        try:\\n            hash(item)\\n        except TypeError:\\n            if not any(item == other for other in seen_unhashable):\\n                seen_unhashable.append(item)\\n                result.append(item)\\n        else:\\n            if item not in seen_hashable:\\n                seen_hashable.add(item)\\n                result.append(item)\\n    return result\\n\\n\\ndef reversed_copy(values):\\n    \\\"\\\"\\\"Return reversed values without modifying the input sequence.\\\"\\\"\\\"\\n    return list(reversed(values))\\n\"}\nReturn the next JSON action.",
