{"type":"text","timestamp":1790854668498,"sessionID":"ses_f08bed584ffeutrzPF57B04YPC","part":{"id":"prt_0f741941f001Pl63FMSq7XaaT4","messageID":"msg_0f7415cea001eiQGOwEpMZdlfm","sessionID":"ses_f08bed584ffeutrzPF57B04YPC","type":"text","text":"{\"action\":\"replace\",\"path\":\"sequences.py\",\"old\":\"def stable_unique(values):\\n    \\\"\\\"\\\"Keep the first occurrence of each equality-distinct value.\\\"\\\"\\\"\\n    raise NotImplementedError(\\\"stable_unique\\\")\",\"new\":\"def stable_unique(values):\\n    \\\"\\\"\\\"Keep the first occurrence of each equality-distinct value.\\\"\\\"\\\"\\n    result = []\\n    seen_hashable = set()\\n    seen_unhashable = []\\n    for item in values:\\n        try:\\n            hash(item)\\n        except TypeError:\\n            if not any(item == other for other in seen_unhashable):\\n                seen_unhashable.append(item)\\n                result.append(item)\\n        else:\\n            if item not in seen_hashable:\\n                seen_hashable.add(item)\\n                result.append(item)\\n    return result\"}","time":{"start":1790854665247,"end":1790854668489}}}
