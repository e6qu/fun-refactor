            "output": "{\"context_basis\":\"frcb1:ce5b674768117b755101c5f52873b7de0f69d73c92a61d9c4afb0eecb135b955\",\"continuations\":[{\"arguments\":[\"project\",\"explore\",\"TTLCache\",\"--mode\",\"behavior\",\"--target\",\"frp1:54fec53a0822f6d5d38166bc86304095:115\",\"--offset\",\"2048\"],\"reason\":\"more-source\"},{\"arguments\":[\"project\",\"explore\",\"TTLCache\",\"--mode\",\"behavior\",\"--target\",\"frp1:54fec53a0822f6d5d38166bc86304095:115\",\"--offset\",\"0\",\"--relations-cursor\",\"frpc1:1b0e6ad8bf41dafd589a978d80a5dafb:8\"],\"reason\":\"more-relationships\"},{\"arguments\":[\"project\",\"explore\",\"TTLCache\",\"--mode\",\"behavior\",\"--target\",\"frp1:54fec53a0822f6d5d38166bc86304095:115\",\"--profile\",\"expanded\"],\"reason\":\"explicit-profile-expansion\"}],\"coverage\":{\"architecture\":\"not inferred\",\"files_by_gap\":{},\"hierarchy\":\"directories and lexical spans\",\"indexed_files\":23,\"manifests\":{\"discovered\":1,\"ecosystems\":4,\"gaps\":0,\"parsed\":1,\"scope\":\"selected scan root\"},\"max_file_bytes\":4194304,\"respect_ignore\":true,\"skipped_files\":0,\"skipped_symlinks\":0,\"unresolved_references\":2483,\"unsupported_files\":8},\"declaration\":{\"node\":{\"children\":13,\"handle\":\"frp1:54fec53a0822f6d5d38166bc86304095:115\",\"kind\":\"class\",\"location\":{\"definition\":{\"range\":{\"end\":{\"col\":21,\"line\":589},\"start\":{\"col\":1,\"line\":451}},\"span\":{\"end\":17135,\"start\":12785}},\"name\":{\"range\":{\"end\":{\"col\":15,\"line\":451},\"start\":{\"col\":7,\"line\":451}},\"span\":{\"end\":12799,\"start\":12791}}},\"name\":\"TTLCache\",\"parent\":\"frp1:54fec53a0822f6d5d38166bc86304095:e\",\"path\":\"src/cachetools/__init__.py\",\"position\":{\"col\":7,\"line\":451},\"qualifier\":null,\"signature\":{\"basis\":\"syntax-header\",\"text\":\"class TTLCache(_TimedCache):\"},\"span\":{\"end\":17135,\"start\":12785}},\"source\":{\"next_offset\":2048,\"offset\":0,\"returned_bytes\":2048,\"span\":{\"end\":14833,\"start\":12785},\"text\":\"class TTLCache(_TimedCache):\\n    \\\"\\\"\\\"LRU Cache implementation with per-item time-to-live (TTL) value.\\\"\\\"\\\"\\n\\n    class _Link:\\n        __slots__ = (\\\"expires\\\", \\\"key\\\", \\\"next\\\", \\\"prev\\\")\\n\\n        def __init__(self, key=None, expires=None):\\n            self.key = key\\n            self.expires = expires\\n\\n        def __reduce__(self):\\n            return TTLCache._Link, (self.key, self.expires)\\n\\n        def unlink(self):\\n            next = self.next\\n            prev = self.prev\\n            prev.next = next\\n            next.prev = prev\\n\\n    def __init__(self, maxsize, ttl, timer=time.monotonic, getsizeof=None):\\n        _TimedCache.__init__(self, maxsize, timer, getsizeof)\\n        self.__root = root = TTLCache._Link()\\n        root.prev = root.next = root\\n        self.__links = collections.OrderedDict()\\n        self.__ttl = ttl\\n\\n    def __contains__(self, key):\\n        try:\\n            link = self.__links[key]  # no reordering\\n        except KeyError:\\n            return False\\n        else:\\n            return self.timer() < link.expires\\n\\n    def __getitem__(self, key, cache_getitem=Cache.__getitem__):\\n        try:\\n            link = self.__getlink(key)\\n        except KeyError:\\n            expired = False\\n        else:\\n            expired = not (self.timer() < link.expires)\\n        if expired:\\n            return self.__missing__(key)\\n        else:\\n            return cache_getitem(self, key)\\n\\n    def __setitem__(self, key, value, cache_setitem=Cache.__setitem__):\\n        with self.timer as time:\\n            self.expire(time)\\n            cache_setitem(self, key, value)\\n        try:\\n            link = self.__getlink(key)\\n        except KeyError:\\n            self.__links[key] = link = TTLCache._Link(key)\\n        else:\\n            link.unlink()\\n        link.expires = time + self.__ttl\\n        link.next = root = self.__root\\n        link.prev = prev = root.prev\\n        prev.next = root.prev = link\\n\\n    def __delitem__(self, key, cache_delitem=Cache.__delitem__):\\n        cache_delitem(self, key)\\n        link = self.__links.pop(key)\\n        \",\"total_bytes\":4350}},\"handle_prefix\":\"frp1:54fec53a0822f6d5d38166bc86304095:\",\"match\":{\"mode\":\"exact\",\"term\":\"TTLCache\"},\"mode\":\"behavior\",\"profile\":{\"enforcement\":\"server\",\"name\":\"compact\",\"relationship_limit\":8,\"report_bytes\":16384,\"row_limit\":12,\"source_bytes\":2048},\"query\":\"explore\",\"relationships\":{\"items\":[{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":0,\"path\":\"collections\"},{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":0,\"path\":\"collections.abc\"},{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":0,\"path\":\"functools\"},{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":0,\"path\":\"heapq\"},{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":0,\"path\":\"random\"},{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":0,\"path\":\"time\"},{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":1,\"path\":\".\"},{\"basis\":\"source-declaration\",\"direction\":\"file-import\",\"glob\":false,\"names\":1,\"path\":\"._cached\"}],\"page\":{\"before\":0,\"next\":\"frpc1:1b0e6ad8bf41dafd589a978d80a5dafb:8\",\"remaining\":280,\"returned\":8,\"total\":288},\"scope\":\"file imports and indexed references; nested source spans included.\"},\"revision\":\"54fec53a0822f6d5d38166bc86304095436a2bb29f6d2f94993879801b79c9ed\",\"schema\":\"fr-project-1\",\"source_refs\":[{\"end\":14833,\"path\":\"src/cachetools/__init__.py\",\"source\":\"src1:7bffd2e24df3027408c5d841aa7986b47a2c13d84cf6014374973752a959688f\",\"start\":12785}]}",
