                    {
                      "path": "src/cachetools/__init__.py",
                      "quote": "    def expire(self, time=None):\n        \"\"\"Remove expired items from the cache and return an iterable of the\n        expired `(key, value)` pairs.\n\n        \"\"\""
                    },
                    {
                      "path": "src/cachetools/__init__.py",
                      "quote": "        while curr is not root and not (time < curr.expires):\n            expired.append((curr.key, cache_getitem(self, curr.key)))\n            cache_delitem(self, curr.key)\n            del links[curr.key]\n            next = curr.next\n            curr.unlink()\n            curr = next\n        return expired"
                    }
                  ],
                  "value": true
                },
