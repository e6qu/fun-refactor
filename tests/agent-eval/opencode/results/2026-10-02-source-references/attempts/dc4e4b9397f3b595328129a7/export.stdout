                  "citations": [
                    {
                      "source": "src1:7bffd2e24df3027408c5d841aa7986b47a2c13d84cf6014374973752a959688f"
                    },
                    {
                      "path": "src/cachetools/__init__.py",
                      "quote": "    def __getitem__(self, key, cache_getitem=Cache.__getitem__):\n        try:\n            link = self.__getlink(key)\n        except KeyError:\n            expired = False\n        else:\n            expired = not (self.timer() < link.expires)\n        if expired:\n            return self.__missing__(key)\n        else:\n            return cache_getitem(self, key)"
                    },
