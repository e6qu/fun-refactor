ll (so if multiple threads share the same retrying\\n                  object - either directly or indirectly) they will each have\\n                  their own view of statistics they have collected (in the\\n                  future we may provide a way to aggregate the various\\n                  statistics from each thread).\\n        \\\"\\\"\\\"\\n        if not hasattr(self._local, \\\"statistics\\\"):\\n            self._local.statistics = t.cast(\\\"dict[str, t.Any]\\\", {})\\n        return self._local.statistics  # type: ignore[no-any-return]\\n\\n    @property\\n    def iter_state(self) -> IterState:\\n        if not hasattr(\"}","metadata":{"truncated":false},"title":"","time":{"start":1790897949529,"end":1790897949532}},"id":"prt_0f9d60b57001u6AL4FaXUk0e1P","sessionID":"ses_f062b7aafffecreGKvjwNJOqiH","messageID":"msg_0f9d5e7fb0019OnBQ09l1WQrxq"}}
