{"type":"tool_use","timestamp":1791157567465,"sessionID":"ses_ef6b1296effedQPZNncCLx5im2","part":{"type":"tool","tool":"rehearsal_search_source","callID":"tool_IWKwtl9FQe8nSzx80IKiNheP","state":{"status":"completed","input":{"text":"override=True"},"output":"{\"matches\":[{\"line\":49,\"offset\":1848,\"path\":\"README.md\",\"sha256\":\"7d06cf7aa8278a4416873e141b5510d99bcc46bd14b440221ef46eba74009441\",\"text\":\"- **Not override** existing environment variables (`override=False`). Pass `override=True` to override existing variables.\"},{\"line\":219,\"offset\":6174,\"path\":\"README.md\",\"sha256\":\"7d06cf7aa8278a4416873e141b5510d99bcc46bd14b440221ef46eba74009441\",\"text\":\"With `load_dotenv(override=True)` or `dotenv_values()`, the value of a variable\"},{\"line\":49,\"offset\":1848,\"path\":\"baseline/README.md\",\"sha256\":\"7d06cf7aa8278a4416873e141b5510d99bcc46bd14b440221ef46eba74009441\",\"text\":\"- **Not override** existing environment variables (`override=False`). Pass `override=True` to override existing variables.\"},{\"line\":219,\"offset\":6174,\"path\":\"baseline/README.md\",\"sha256\":\"7d06cf7aa8278a4416873e141b5510d99bcc46bd14b440221ef46eba74009441\",\"text\":\"With `load_dotenv(override=True)` or `dotenv_values()`, the value of a variable\"},{\"line\":515,\"offset\":16585,\"path\":\"baseline/src/dotenv/main.py\",\"sha256\":\"fcb89122cd8756c43209f9052bb3c552dbe440d45493c762295c771f0d1ceaa8\",\"text\":\"        override=True,\"},{\"line\":515,\"offset\":16585,\"path\":\"src/dotenv/main.py\",\"sha256\":\"fcb89122cd8756c43209f9052bb3c552dbe440d45493c762295c771f0d1ceaa8\",\"text\":\"        override=True,\"}],\"omitted_matches\":0,\"source_refs\":[{\"end\":1970,\"path\":\"README.md\",\"source\":\"src1:ff0cb062e2dcda3b729c39122a96e1f971b33d10fc18c118ef3abb040e2d075b\",\"start\":1848},{\"end\":6253,\"path\":\"README.md\",\"source\":\"src1:c4f36d9ad0f2ced92012a629d1b7f39dc0f2505261b2623b95d54d578925143e\",\"start\":6174},{\"end\":1970,\"path\":\"baseline/README.md\",\"source\":\"src1:1a87321daabcad549395fd1db4d6e2a1bc6ce05a6a7f91d2c3e309e3ebd12e9e\",\"start\":1848},{\"end\":6253,\"path\":\"baseline/README.md\",\"source\":\"src1:030a1aee1e297ecb42598f792db8c61065375b8469b23521c98ede8d66977457\",\"start\":6174},{\"end\":16607,\"path\":\"baseline/src/dotenv/main.py\",\"source\":\"src1:cdce4a94401e99d5b671e3060cd9d3689607d04e985d0e5266e7105a53e3134c\",\"start\":16585},{\"end\":16607,\"path\":\"src/dotenv/main.py\",\"source\":\"src1:45e98632f001dd2d95d44e5b7a46925e520bc9c20abbc0189ccafbb94e63d6ff\",\"start\":16585}],\"unreadable_files\":0}","metadata":{"truncated":false},"title":"","time":{"start":1791157567462,"end":1791157567465}},"id":"prt_1094f7fe40012vIBiLlJB2Mbgz","sessionID":"ses_ef6b1296effedQPZNncCLx5im2","messageID":"msg_1094f6a5e001sIEGMR191Xmfbx"}}
