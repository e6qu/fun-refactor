\\\\\\"\\\\\\\"\\\", \\\"new\\\": \\\"        if self.operator == \\\\\\\"+\\\\\\\":\\\\n            return (self.default or \\\\\\\"\\\\\\\") if env.get(self.name) else \\\\\\\"\\\\\\\"\\\\n        default = self.default if self.default is not None else \\\\\\\"\\\\\\\"\\\"}, {\\\"path\\\": \\\"src/dotenv/variables.py\\\", \\\"old\\\": \\\"yield Variable(name=name, default=default)\\\", \\\"new\\\": \\\"yield Variable(name=name, default=default, operator=match[\\\\\\\"operator\\\\\\\"] or \\\\\\\"-\\\\\\\")\\\"}]}\"}","metadata":{"truncated":false},"title":"","time":{"start":1791181051081,"end":1791181051086}},"id":"prt_10ab5d4c8001kO8SQv5y7ST67u","sessionID":"ses_ef54b527effet2B75oZ2fFxNUK","messageID":"msg_10ab5be48001eASwsA9qr8CnIe"}}
