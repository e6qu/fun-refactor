+/// Returns the UTF-8 byte length of the escaped form of `text`.
+///
+/// This is the number of bytes that [`escape`] (or [`escape_into`]) would
+/// produce for `text`, computed without allocating a temporary string.
+///
+/// The escaped form of `text` may be safely used as a literal in a regular
+/// expression.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
+}
