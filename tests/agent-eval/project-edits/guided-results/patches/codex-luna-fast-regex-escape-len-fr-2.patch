+/// Returns the number of UTF-8 bytes in the escaped form of `text`.
+///
+/// This returns the same length as [`escape`](escape) without allocating a
+/// string.
+///
+/// # Example
+///
+/// ```
+/// assert_eq!(regex_syntax::escape_len(""), 0);
+/// assert_eq!(regex_syntax::escape_len("a.b"), 4);
+/// assert_eq!(regex_syntax::escape_len("é"), 2);
+/// ```
+pub fn escape_len(text: &str) -> usize {
+    text.len() + text.chars().filter(|&c| is_meta_character(c)).count()
+}
