+/// Returns the length, in UTF-8 bytes, of the string produced by escaping
+/// all regular expression meta characters in `text`.
+///
+/// This is exactly the number of bytes that [`escape`] would return and that
+/// [`escape_into`] would append to a buffer for the same input, but it is
+/// computed without allocating or building the escaped string.
+///
+/// # Example
+///
+/// ```
+/// use regex_syntax::escape_len;
+///
+/// assert_eq!(escape_len(""), 0);
+/// assert_eq!(escape_len("a.b"), 4);
+/// assert_eq!(escape_len("é"), 2);
+/// ```
+pub fn escape_len(text: &str) -> usize {
+    let mut len = 0;
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+        len += c.len_utf8();
+    }
+    len
+}
