+/// Returns the number of bytes in the escaped form of `text`, without
+/// allocating.
+///
+/// This is equivalent to the length in bytes of the string returned by
+/// [`escape`], but computed without building that string.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
