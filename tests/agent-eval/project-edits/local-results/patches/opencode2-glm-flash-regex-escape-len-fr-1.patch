+/// Returns the number of bytes that [`escape`] would produce for `text`.
+///
+/// This counts the bytes of the escaped form of `text` without allocating
+/// a temporary string.
+pub fn escape_len(text: &str) -> usize {
+    let mut len = 0;
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+        len += c.len_utf8();
+    }
+    len
+}
