+/// Returns the number of bytes in the escaped form of `text`.
+///
+/// This is equivalent to the length of the string returned by [`escape`],
+/// but is computed without allocating.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
+}
