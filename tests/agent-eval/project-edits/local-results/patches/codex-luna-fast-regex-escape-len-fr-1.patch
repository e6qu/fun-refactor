+/// Returns the number of UTF-8 bytes in the escaped form of `pattern`.
+pub fn escape_len(pattern: &str) -> usize {
+    pattern
+        .chars()
+        .map(|ch| ch.len_utf8() + usize::from(is_meta_character(ch)))
+        .sum()
+}
