+/// Returns the UTF-8 byte length of `text` after regex meta characters are
+/// escaped.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
+}
