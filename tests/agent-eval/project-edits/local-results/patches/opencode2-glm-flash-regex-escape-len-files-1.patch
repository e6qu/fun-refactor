+/// Returns the number of bytes in the escaped form of `text`.
+///
+/// This is the length of the string returned by [`escape`] or the number of
+/// characters appended by [`escape_into`], computed without allocating.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
+}
