+/// Returns the UTF-8 byte length of `pattern` after escaping all regular
+/// expression meta characters.
+///
+/// This computes the length of the string that [`escape`] would return
+/// without allocating a temporary string.
+pub fn escape_len(pattern: &str) -> usize {
+    let mut len = 0;
+    for c in pattern.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+        len += c.len_utf8();
+    }
+    len
+}
