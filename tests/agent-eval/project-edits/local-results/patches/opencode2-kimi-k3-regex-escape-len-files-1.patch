+/// Returns the length in bytes of the escaped form of `text`.
+///
+/// That is, `escape_len(text)` is exactly `escape(text).len()`, but computed
+/// without building the escaped string.
+pub fn escape_len(text: &str) -> usize {
+    let mut len = text.len();
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+    }
+    len
