+/// Returns the number of UTF-8 bytes that escaping `text` would produce.
+///
+/// This is equivalent to `escape(text).len()`, but does not allocate a
+/// temporary string. This can be used, for example, to pre-size a buffer
+/// passed to [`escape_into`].
+///
+/// # Example
+///
+/// ```
+/// use regex_syntax::escape_len;
+///
+/// assert_eq!(escape_len(""), 0);
+/// assert_eq!(escape_len("a.b"), 4);
+/// assert_eq!(escape_len("é"), 2);
+/// ```
+pub fn escape_len(text: &str) -> usize {
+    let mut len = 0;
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+        len += c.len_utf8();
+    }
+    len
+}
