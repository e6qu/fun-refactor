+/// Returns the number of UTF-8 bytes needed to store the escaped form of
+/// `text`.
+///
+/// This is equivalent to `escape(text).len()`, but does not allocate a
+/// temporary string.
+pub fn escape_len(text: &str) -> usize {
+    let mut len = text.len();
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+    }
+    len
+}
