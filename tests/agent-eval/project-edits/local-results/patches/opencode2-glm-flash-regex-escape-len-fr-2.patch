+/// Returns the length, in bytes, of the escaped form of `text`.
+///
+/// This is the exact UTF-8 length of the string returned by [`escape`]
+/// (or appended by [`escape_into`]) for the same `text`, and it is
+/// computed without allocating.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
+}
