+/// Returns the UTF-8 byte length of `text` after escaping all regular
+/// expression meta characters.
+///
+/// This is equivalent to `escape(text).len()`, but does not allocate a
+/// temporary string. Escaping appends one `\` byte before each meta
+/// character, so this returns `text.len()` plus the number of meta
+/// characters in `text`.
+pub fn escape_len(text: &str) -> usize {
+    let mut len = text.len();
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+    }
+    len
+}
