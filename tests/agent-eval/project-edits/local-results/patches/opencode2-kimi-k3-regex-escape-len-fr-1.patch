+/// Returns the length, in UTF-8 bytes, of the result of escaping `text`.
+///
+/// This is equivalent to `escape(text).len()`, but does not allocate.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + if is_meta_character(c) { 1 } else { 0 })
+        .sum()
+}
