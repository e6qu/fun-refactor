+/// Returns the number of UTF-8 bytes in the escaped form of `text`.
+///
+/// This is equivalent to `escape(text).len()`, but does not allocate.
+///
+/// # Example
+///
+/// ```
+/// use regex_syntax::escape_len;
+///
+/// assert_eq!(escape_len(""), 0);
+/// assert_eq!(escape_len("a.b"), 4);
+/// assert_eq!(escape_len("é"), 2);
+/// ```
+pub fn escape_len(text: &str) -> usize {
+    text.len() + text.chars().filter(|&c| is_meta_character(c)).count()
+}
