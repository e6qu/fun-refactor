+/// Returns the length in bytes of the escaped form of `text`.
+///
+/// The value returned is the number of UTF-8 encoded bytes that
+/// [`escape_into`] would append to a buffer, computed without allocating.
+pub fn escape_len(text: &str) -> usize {
+    text.chars()
+        .map(|c| c.len_utf8() + usize::from(is_meta_character(c)))
+        .sum()
+}
