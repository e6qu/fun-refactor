+/// Returns the length, in UTF-8 encoded bytes, of the escaped form of `text`.
+///
+/// This returns the same value as `escape(text).len()`, but without
+/// allocating a temporary string. The escaping performed is identical to
+/// [`escape`]: each meta character is prefixed with a `\`.
+///
+/// # Example
+///
+/// ```
+/// assert_eq!(regex_syntax::escape_len(""), 0);
+/// assert_eq!(regex_syntax::escape_len("a.b"), 4);
+/// assert_eq!(regex_syntax::escape_len("é"), 2);
+/// ```
+pub fn escape_len(text: &str) -> usize {
+    let mut len = text.len();
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+    }
+    len
+}
