+/// Returns the length, in bytes, of `text` after escaping all regular
+/// expression meta characters.
+///
+/// This is equivalent to the length of the string returned by [`escape`],
+/// but it does not allocate.
+pub fn escape_len(text: &str) -> usize {
+    let mut len = 0;
+    for c in text.chars() {
+        if is_meta_character(c) {
+            len += 1;
+        }
+        len += c.len_utf8();
+    }
+    len
+}
