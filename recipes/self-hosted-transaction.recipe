schema 1

recipe individual-report-name {
  description "Keep the per-recipe outcome printer's settled name."
  requires any symbol "print_recipe_report" "print_recipe_outcome" where kind=function in="src/cli.rs"
  rename to "print_recipe_outcome" where name="print_recipe_report" kind=function in="src/cli.rs" allow-empty
  expect step 1 matched = 0
  expect step 1 applied = 0
  expect step 1 changed = 0 files
  expect step 1 refusals = 0
}

recipe transaction-report-name {
  description "Keep the recipe transaction printer's settled name."
  requires any symbol "print_workspace_recipe_report" "print_recipe_transaction_outcome" where kind=function in="src/cli.rs"
  rename to "print_recipe_transaction_outcome" where name="print_workspace_recipe_report" kind=function in="src/cli.rs" allow-empty
  expect step 1 matched = 0
  expect step 1 applied = 0
  expect step 1 changed = 0 files
  expect step 1 refusals = 0
}
