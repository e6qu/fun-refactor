schema 1

recipe individual-report-name {
  description "Keep the per-recipe outcome printer's settled name."
  requires any symbol "print_recipe_report" "print_recipe_outcome" where kind=function in="src/cli.rs"
  rename to "print_recipe_outcome" where name="print_recipe_report" kind=function in="src/cli.rs" allow-empty id "individual-report"
  expect step "individual-report" matched = 0
  expect step "individual-report" applied = 0
  expect step "individual-report" changed = 0 files
  expect step "individual-report" refusals = 0
}

recipe transaction-report-name {
  description "Keep the recipe transaction printer's settled name."
  requires any symbol "print_workspace_recipe_report" "print_recipe_transaction_outcome" where kind=function in="src/cli.rs"
  rename to "print_recipe_transaction_outcome" where name="print_workspace_recipe_report" kind=function in="src/cli.rs" allow-empty id "transaction-report"
  expect step "transaction-report" matched = 0
  expect step "transaction-report" applied = 0
  expect step "transaction-report" changed = 0 files
  expect step "transaction-report" refusals = 0
}
